# Corporate Chat — DEP-01.2 | Proxy HTTPS (Caddy)
#
# - Emite e renova o certificado Let's Encrypt automaticamente para CHAT_DOMAIN.
# - Redireciona HTTP -> HTTPS.
# - Serve o frontend (build do Vite) e encaminha /api e /socket.io para a API.
#
# Variáveis (definidas em deploy/.env e repassadas pelo docker-compose.aws.yml):
#   CHAT_DOMAIN   ex.: 15-228-10-20.sslip.io ou chat.suaequipe.com.br
#   ACME_EMAIL    e-mail da equipe para avisos do Let's Encrypt
#   API_UPSTREAM  (opcional) padrão api:3000
#   SITE_ROOT     (opcional) padrão /srv

{
	email {$ACME_EMAIL}
	admin off
}

{$CHAT_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' wss://{host}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}

	@backend path /api/* /socket.io/*
	handle @backend {
		reverse_proxy {$API_UPSTREAM:api:3000}
	}

	handle {
		root * {$SITE_ROOT:/srv}

		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		@spa not path /assets/*
		header @spa Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
