# Corporate Chat — DEP-01.3 | Backup diário (executado pelo corporate-chat-backup.timer)
# Instalação: docs/deploy/DEP-01-3-SEGURANCA-E-RECUPERACAO.md, seção 3.
[Unit]
Description=Corporate Chat - backup do PostgreSQL e do MongoDB
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=docker
WorkingDirectory=/opt/corporate-chat
Environment=BACKUP_DIR=/var/backups/corporate-chat
Environment=BACKUP_RETENTION_DAYS=7
ExecStart=/usr/bin/bash /opt/corporate-chat/deploy/scripts/backup.sh
Nice=10
IOSchedulingClass=idle
